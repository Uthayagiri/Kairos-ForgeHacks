  "executive_summary_root_cause": {
    "core_finding": "TRAIN/TEST SPLIT ALIGNMENT MISMATCH (IN-SAMPLE CONTAMINATION OF EVALUATION METRIC)",
    "explanation": "Production Model v2.1.0 was originally trained on an 80/20 GroupShuffleSplit partition (7,111 train rows, 1,799 test rows). In the candidate experiments, evaluation was conducted on GroupKFold Fold 1 (1,782 test rows). Because GroupKFold and GroupShuffleSplit construct non-identical domain groupings, 84.01% (1,497/1,782) of all test samples and 91.58% (370/404) of all phishing test samples in GroupKFold Fold 1 were actually part of the training set of Production Model v2.1.0. Thus, the reported 98.56% production recall was measuring in-sample training recall rather than held-out generalization.",
    "production_true_out_of_sample_metrics": {
      "split_method": "GroupShuffleSplit(n_splits=1, test_size=0.20, random_state=42)",
      "test_samples": 1799,
      "test_domains": 631,
      "accuracy": 0.9455,
      "recall": 0.9421,
      "precision": 0.833,
      "f1_score": 0.8842,
      "roc_auc": 0.9819,
      "confusion_matrix": {
        "tn": 1327,
        "fp": 75,
        "fn": 23,
        "tp": 374
      }
    }
  },
